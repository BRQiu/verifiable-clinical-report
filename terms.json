  "generic_terms": {
    "_comment": "笼统说法 —— 不该静默解析成某一个具体指标，而应展开成全部候选，由数据可用性筛掉。医生只说「血糖」时，系统不该私自认定他指的是空腹还是随机。",
    "血糖": [
      "glucose_fasting",
      "glucose_postprandial",
      "glucose_random"
    ],
    "葡萄糖": [
      "glucose_fasting",
      "glucose_postprandial",
      "glucose_random"
    ],
