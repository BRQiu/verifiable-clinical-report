      "creatinine",
      "egfr",
      "ua"
    ],
    "胆固醇": [
      "tc",
      "hdl",
      "ldl"
    ]
  },
  "unit_conversions": {
    "_comment": "统一到内部单位。因子 = 内部单位下的值 / 原始单位下的值",
    "glucose_mgdl_to_mmoll": {
      "metric_group": [
        "glucose_fasting",
        "glucose_postprandial",
        "glucose_random"
      ],
      "from": "mg/dL",
      "factor": 0.0555
    },
    "hba1c_ifcc_to_ngsp": {
      "metric_group": [
        "hba1c"
      ],
      "from": "mmol/mol",
      "factor": null,
      "note": "非线性：(IFCC/10.929)+2.15"
    },
    "creatinine_mgdl_to_umoll": {
      "metric_group": [
        "creatinine"
      ],
      "from": "mg/dL",
      "factor": 88.4
    },
    "tc_mgdl_to_mmoll": {
      "metric_group": [
        "tc",
        "hdl",
        "ldl"
      ],
      "from": "mg/dL",
      "factor": 0.0259
    },
    "tg_mgdl_to_mmoll": {
      "metric_group": [
        "tg"
      ],
      "from": "mg/dL",
      "factor": 0.0113
    },
    "ua_mgdl_to_umoll": {
      "metric_group": [
        "ua"
      ],
      "from": "mg/dL",
      "factor": 59.48
    },
    "waist_in_to_cm": {
      "metric_group": [
        "waist"
      ],
      "from": "in",
      "factor": 2.54
    },
    "weight_lb_to_kg": {
      "metric_group": [
        "weight"
      ],
      "from": "lb",
      "factor": 0.4536
    },
    "cells_to_10e3_0": {
      "metric_group": [
        "wbc",
        "platelets"
      ],
      "from": "/uL",
      "factor": 0.001,
      "note": "12,000/µL = 12 ×10³/µL；少这个因子数值会差 1000 倍却依然合理"
    },
    "cells_to_10e3_1": {
      "metric_group": [
        "wbc",
        "platelets"
      ],
      "from": "/µL",
      "factor": 0.001,
      "note": "12,000/µL = 12 ×10³/µL；少这个因子数值会差 1000 倍却依然合理"
    },
    "cells_to_10e3_2": {
